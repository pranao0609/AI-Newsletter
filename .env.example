# Example environment variables for Render deployment
# Copy these to Render Dashboard → Environment Variables

# AI API Key
GROQ_API_KEY=your_groq_api_key_here

# Email Configuration
MY_EMAIL=your_email@gmail.com
APP_PASSWORD=your_gmail_app_password_here

# Database Configuration (auto-populated by Render from PostgreSQL service)
# POSTGRES_USER=ai_news_user
# POSTGRES_PASSWORD=<auto-generated>
# POSTGRES_HOST=<auto-generated>
# POSTGRES_PORT=5432
# POSTGRES_DB=ai_news_aggregator
